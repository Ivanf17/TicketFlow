# Copy this file to .env and fill in real local values.
# Never commit the real .env file.

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=ticketflow_db
DB_USER=ticketflow_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (only used for password reset; ticket notifications stay internal)
# Leave EMAIL_BACKEND unset (or "django.core.mail.backends.console.EmailBackend")
# to print reset emails to the console in development/testing.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@ticketflow.local
